<Window x:Class="Lesson2.案例1.GridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson2.案例1"
        mc:Ignorable="d"
        Title="GridWindow" Height="450" Width="800">
    
    <!-- 最外层根 Grid：负责纵向三等分（Top, Middle, Bottom） -->
    <Grid>
        <!-- 1. 定义三行 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 顶部菜单，高度自适应内容 -->
            <RowDefinition Height="*" />
            <!-- 中间主体，占满剩余所有空间 -->
            <RowDefinition Height="Auto" />
            <!-- 底部状态栏，高度自适应内容 -->
        </Grid.RowDefinitions>

        <!-- ========================================= -->
        <!-- 区域 A：顶部菜单栏 (第 0 行)               -->
        <!-- ========================================= -->
        <Border Grid.Row="0" Background="#2C3E50" Height="50">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                <TextBlock Text="📋 文件" Foreground="White" FontWeight="Bold" Margin="0,0,20,0"/>
                <TextBlock Text="✏️ 编辑" Foreground="White" FontWeight="Bold" Margin="0,0,20,0"/>
                <TextBlock Text="⚙️ 工具" Foreground="White" FontWeight="Bold" Margin="0,0,20,0"/>
                <TextBlock Text="❓ 帮助" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- ========================================= -->
        <!-- 区域 B：核心工作区 (第 1 行)               -->
        <!-- 嵌套第二个 Grid，负责横向三分              -->
        <!-- ========================================= -->
        <Grid Grid.Row="1">
            <!-- 2. 定义三列 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <!-- 左侧导航，固定宽度 -->
                <ColumnDefinition Width="Auto" />
                <!-- 分隔条，宽度自适应 -->
                <ColumnDefinition Width="*" />
                <!-- 右侧内容，填充剩余 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧导航面板 (第 0 列) -->
            <Border Grid.Column="0" Background="#ECF0F1" BorderBrush="#BDC3C7" BorderThickness="0,0,1,0">
                <StackPanel Margin="15">
                    <TextBlock Text="📁 导航菜单" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" Foreground="#34495E"/>
                    <Button Content="🏠 控制台" Height="35" Margin="0,5" Background="#3498DB" Foreground="White" BorderThickness="0"/>
                    <Button Content="📊 数据报表" Height="35" Margin="0,5" Background="#95A5A6" Foreground="White" BorderThickness="0"/>
                    <Button Content="👤 用户管理" Height="35" Margin="0,5" Background="#95A5A6" Foreground="White" BorderThickness="0"/>
                    <Button Content="⚙️ 系统设置" Height="35" Margin="0,5" Background="#95A5A6" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Grid 分隔条 (第 1 列) 
                 用户鼠标拖动它，可以改变左右两侧的大小 -->
            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch"
                          Background="#7F8C8D"
                          ResizeBehavior="BasedOnAlignment"
                          ResizeDirection="Columns" />

            <!-- 右侧主要内容区 (第 2 列) -->
            <Border Grid.Column="2" Background="#FFFFFF">
                <Grid>
                    <TextBlock Text="📄 欢迎使用 WPF 应用程序" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               FontSize="28" 
                               Foreground="#BDC3C7"
                               FontWeight="SemiBold"/>

                    <!-- 在右下角加一个小提示，展示 Grid 的精确嵌套 -->
                    <TextBlock Text="右侧内容区 (Width='*' 自动拉伸)" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Bottom" 
                               Margin="15" 
                               FontSize="12"
                               Foreground="#95A5A6"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================= -->
        <!-- 区域 C：底部状态栏 (第 2 行)              -->
        <!-- ========================================= -->
        <Border Grid.Row="2" Background="#34495E" Height="30">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                <TextBlock Text="✅ 系统运行正常" Foreground="White" FontSize="12"/>
                <TextBlock Text="|" Foreground="#7F8C8D" Margin="15,0"/>
                <TextBlock Text="用户: 管理员" Foreground="White" FontSize="12"/>
                <TextBlock Text="|" Foreground="#7F8C8D" Margin="15,0"/>
                <TextBlock Text="当前内存: 256 MB" Foreground="White" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<!--
   “企业级桌面应用骨架”（顶部菜单栏 + 左侧导航栏 + 右侧内容区 + 底部状态栏）案例。
    - 这是 WPF 中最常见、最实用的布局模板，涵盖了 Auto、*、固定像素、GridSplitter（拖动调整大小）和嵌套 Grid 等核心知识点。
    
    布局思路（核心设计策略）
    1，总体划分（行）：

    将主窗口划分为 3 行：
    - 第 0 行：顶部菜单/工具栏（高度 Auto，随内容撑高）。
    - 第 1 行：核心工作区（高度 *，占据所有剩余空间）。
    - 第 2 行：底部状态栏（高度 Auto，仅仅显示文字）。

    2，核心工作区划分（列）：

    在第 1 行中嵌套一个 子 Grid，划分为 3 列：
    - 第 0 列：左侧导航面板（固定宽度 200，保证稳定）。
    - 第 1 列：GridSplitter 拖动条（宽度 Auto，实际渲染仅 5px）。
    - 第 2 列：右侧主要内容展示区（宽度 *，自动填满剩余窗口宽度）。

    3，自适应策略：

    顶部和底部使用 Auto，保证它们“内容有多少，就占多少”。
    中间使用 *，保证窗口拉大时，只有内容区在变化，菜单栏和状态栏高度不变。
    左侧用固定像素 200，右侧用 *，配合 GridSplitter，让用户可以自由拖动调整左右面板的比例，但右侧永远不会“挤没”。
-->