<Window x:Class="Lesson2.案例4.DockPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson2.案例4"
        mc:Ignorable="d"
        Title="DockPanelWindow" Height="450" Width="800">
    <!-- DockPanel 作为根面板，自动处理边缘停靠 -->
    <DockPanel LastChildFill="True">
        <!-- 最后一个子元素填满剩余空间，默认为 True -->

        <!-- ============================================ -->
        <!-- 1. 顶部菜单栏：停靠到上边缘                -->
        <!-- ============================================ -->
        <Border DockPanel.Dock="Top" 
                Background="#2C3E50" 
                Height="40">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                <TextBlock Text="📁 文件" Foreground="White" Margin="0,0,20,0"/>
                <TextBlock Text="✏️ 编辑" Foreground="White" Margin="0,0,20,0"/>
                <TextBlock Text="🔍 视图" Foreground="White" Margin="0,0,20,0"/>
                <TextBlock Text="⚙️ 工具" Foreground="White" Margin="0,0,20,0"/>
                <TextBlock Text="❓ 帮助" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- 2. 底部状态栏：停靠到下边缘                -->
        <!-- ============================================ -->
        <Border DockPanel.Dock="Bottom" 
                Background="#34495E" 
                Height="30">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                <TextBlock Text="✅ 就绪" Foreground="White" FontSize="12"/>
                <TextBlock Text="|" Foreground="#7F8C8D" Margin="15,0"/>
                <TextBlock Text="行: 1  列: 1" Foreground="White" FontSize="12"/>
                <TextBlock Text="|" Foreground="#7F8C8D" Margin="15,0"/>
                <TextBlock Text="UTF-8" Foreground="White" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- 3. 左侧面板（解决方案资源管理器）：停靠到左 -->
        <!-- ============================================ -->
        <Border DockPanel.Dock="Left" 
                Background="#ECF0F1" 
                Width="220" 
                BorderBrush="#BDC3C7" 
                BorderThickness="0,0,1,0">
            <StackPanel Margin="15">
                <TextBlock Text="📂 解决方案资源管理器" 
                           FontWeight="Bold" 
                           FontSize="14" 
                           Foreground="#2C3E50" 
                           Margin="0,0,0,15"/>
                <TreeView Background="Transparent" BorderThickness="0">
                    <TreeViewItem Header="📁 解决方案 'MyApp' (1 个项目)">
                        <TreeViewItem Header="📁 MyApp">
                            <TreeViewItem Header="📄 MainWindow.xaml"/>
                            <TreeViewItem Header="📄 App.xaml"/>
                            <TreeViewItem Header="📁 属性"/>
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeView>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- 4. 右侧面板（属性窗口）：停靠到右            -->
        <!-- ============================================ -->
        <Border DockPanel.Dock="Right" 
                Background="#F4F6F7" 
                Width="240" 
                BorderBrush="#BDC3C7" 
                BorderThickness="1,0,0,0">
            <StackPanel Margin="15">
                <TextBlock Text="📋 属性" 
                           FontWeight="Bold" 
                           FontSize="14" 
                           Foreground="#2C3E50" 
                           Margin="0,0,0,15"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Foreground="#7F8C8D" Margin="0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="MainWindow" Margin="5,5" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="宽度" Foreground="#7F8C8D" Margin="0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="800" Margin="5,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="高度" Foreground="#7F8C8D" Margin="0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="500" Margin="5,5"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================================ -->
        <!-- 5. 中间主编辑区：不设 Dock，自动填充剩余     -->
        <!-- ============================================ -->
        <Border Background="#FFFFFF">
            <Grid>
                <TextBlock Text="📄 主编辑区域（代码 / 设计视图）" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           FontSize="24" 
                           Foreground="#BDC3C7"
                           FontWeight="SemiBold"/>
                <!-- 右下角加个小水印 -->
                <TextBlock Text="DockPanel.LastChildFill = True" 
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Bottom" 
                           Margin="15" 
                           FontSize="12" 
                           Foreground="#D5D8DC"/>
            </Grid>
        </Border>

    </DockPanel>
</Window>
    
<!--
    Visual Studio / Office 风格的 IDE 界面（顶部菜单栏、底部状态栏、左侧工具箱、右侧属性面板，中间编辑器填满剩余空间）案例
    
    设计思路
    - 1，DockPanel 的核心规则：
      - 每个子元素通过附加属性 DockPanel.Dock 指定停靠位置（Top、Bottom、Left、Right）。
      - 默认情况下，最后一个子元素如果没有显式指定 Dock，会自动填满剩余空间（因为 LastChildFill 默认是 true）。
      - 停靠顺序按照子元素声明的先后顺序：先声明的先占边缘，后声明的依次向内“挤压”。
    
    - 2，典型 IDE 界面结构：
      - 顶部：菜单栏 / 工具栏（Dock="Top"）
      - 底部：状态栏（Dock="Bottom"）
      - 左侧：工具面板 / 文件树（Dock="Left"）
      - 右侧：属性面板 / 大纲（Dock="Right"）
      - 中间：主编辑区域（不设置 Dock，利用 LastChildFill 自动填满）
    
    - 3，本案例要模拟的效果：
      - 我们将构建一个简化版的“开发环境”界面，每个区域用不同颜色的 Border 区分，并显示文字标识，让你一目了然地看到每个面板的停靠位置。
 -->
