<Window x:Class="Lesson2.案例7.BorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson2.案例7"
        mc:Ignorable="d"
        Title="BorderWindow" 
        Height="550" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">
    <!-- 整体使用 Grid 进行页面布局 -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="🎨 Border 应用示例" 
                   FontSize="28" FontWeight="Bold" 
                   Foreground="#2C3E50" 
                   HorizontalAlignment="Center" Margin="0,10,0,30"/>

        <!-- 主体区域：四个 Border 场景，用 Grid 分成 2x2 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- 场景一：卡片式面板（带圆角和阴影效果）            -->
            <!-- ================================================= -->
            <Border Grid.Row="0" Grid.Column="0" 
                    Margin="10" 
                    Background="White" 
                    BorderBrush="#D5D8DC" 
                    BorderThickness="1" 
                    CornerRadius="12"
                    Padding="15">
                <!-- 实现阴影：在 Border 下方再叠一层半透明 Border -->
                <Grid>
                    <!-- 阴影层（通过 Margin 偏移模拟） -->
                    <Border Background="Black" 
                            Opacity="0.1" 
                            CornerRadius="12" 
                            Margin="5,5,0,0" />
                    <!-- 内容层 -->
                    <Border Background="White" 
                            CornerRadius="12" 
                            BorderBrush="#D5D8DC" 
                            BorderThickness="1"
                            Padding="15">
                        <StackPanel>
                            <TextBlock Text="📋 信息卡片" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#2C3E50" 
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="这是使用 Border 创建的卡片，拥有圆角、边框和投影效果。适用于展示数据摘要或功能入口。" 
                                       TextWrapping="Wrap" 
                                       Foreground="#7F8C8D" 
                                       FontSize="14"/>
                            <Button Content="查看详情" 
                                    HorizontalAlignment="Right" 
                                    Margin="0,15,0,0" 
                                    Background="#3498DB" 
                                    Foreground="White" 
                                    BorderThickness="0" 
                                    Padding="10,5"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================================================= -->
            <!-- 场景二：圆角头像（将文字裁剪为圆形）              -->
            <!-- ================================================= -->
            <Border Grid.Row="0" Grid.Column="1" 
                    Margin="10" 
                    Background="#ECF0F1" 
                    CornerRadius="15" 
                    Padding="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="圆形头像" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <!-- 头像 Border：圆形裁剪 -->
                    <Border Width="100" Height="100" 
                            CornerRadius="50" 
                            Background="#3498DB" 
                            HorizontalAlignment="Center" 
                            BorderBrush="White" 
                            BorderThickness="4">
                        <TextBlock Text="JD" 
                                   FontSize="36" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="John Doe" FontSize="14" Foreground="#34495E" 
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="开发者" FontSize="12" Foreground="#7F8C8D" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ================================================= -->
            <!-- 场景三：分组框（用 Border + TextBlock 模拟 GroupBox） -->
            <!-- ================================================= -->
            <Border Grid.Row="1" Grid.Column="0" 
                    Margin="10" 
                    Background="White" 
                    BorderBrush="#BDC3C7" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="15,25,15,15">
                <Grid>
                    <!-- 分组标题（绝对定位在顶部边框上） -->
                    <TextBlock Text="📁 基本信息" 
                               FontWeight="Bold" 
                               Background="White" 
                               Padding="10,0" 
                               Foreground="#2C3E50" 
                               Margin="15,-12,0,0" 
                               VerticalAlignment="Top" 
                               HorizontalAlignment="Left"/>
                    <StackPanel Margin="0,10,0,0">
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="姓名：" Foreground="#7F8C8D" Grid.Column="0"/>
                            <TextBlock Text="张三" Grid.Column="1" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="年龄：" Foreground="#7F8C8D" Grid.Column="0"/>
                            <TextBlock Text="28" Grid.Column="1" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="职业：" Foreground="#7F8C8D" Grid.Column="0"/>
                            <TextBlock Text="软件工程师" Grid.Column="1" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================= -->
            <!-- 场景四：带边框的网格区域（整体边框+背景）        -->
            <!-- ================================================= -->
            <Border Grid.Row="1" Grid.Column="1" 
                    Margin="10" 
                    Background="#FEF9E7" 
                    BorderBrush="#F1C40F" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="⭐ 重点提示" 
                               FontWeight="Bold" 
                               FontSize="16" 
                               Foreground="#D4AC0D" 
                               Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Text="Border 可以包裹任何单个元素（Grid、StackPanel、TextBlock等），为它们统一添加背景和边框。非常适合高亮特定区域。" 
                               TextWrapping="Wrap" 
                               Foreground="#7F6B1E" 
                               FontSize="14"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

<!--
    设计思路
    - 1，Border 的核心属性：
      - Background：背景色（可用 SolidColorBrush、渐变等）。
      - BorderBrush 和 BorderThickness：边框颜色和粗细。
      - CornerRadius：圆角半径（可分别设置四个角）。
      - Padding：内部内容与边框之间的留白。
      - Margin：外部与父容器的距离（类似所有元素都有）。
    
    - 2，本案例要展示的场景：
      - 场景一：卡片式面板 —— 带圆角和阴影的信息卡片，常用于仪表盘或列表项。
      - 场景二：圆角头像 —— 将图片或文字裁剪为圆形。
      - 场景三：分组框（GroupBox 替代） —— 用 Border + TextBlock 模拟带标题的分组区域。
      - 场景四：带边框的网格区域 —— 用 Border 包裹 Grid，为整个区域添加边框和背景。
    
    - 3，为什么学 Border：
      - Border 是 WPF 中最常用的 UI 美化工具，几乎每个复杂界面都会用到它。
      - 它轻量且高效，比使用 Rectangle+Grid 等方式更简洁。
-->