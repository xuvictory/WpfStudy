<Window x:Class="Lesson2.案例2.StackPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson2.案例2"
        mc:Ignorable="d"
        Title="StackPanelWindow" Height="450" Width="800">
    <!-- 外层 Grid：用来固定顶部工具栏，让列表区域可滚动 -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- 第0行：工具栏，高度自适应内容（Auto） -->
            <RowDefinition Height="Auto" />
            <!-- 第1行：联系人列表，占满剩余全部空间（*） -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================= -->
        <!-- 区域一：顶部工具栏（横向 StackPanel 经典用法） -->
        <!-- ============================================= -->
        <Border Grid.Row="0" Background="#34495E" Padding="10,5">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center">

                <!-- 按钮之间用 Margin 拉开间距，右侧留白 -->
                <Button Content="➕ 新增" 
                        Width="80" 
                        Height="30" 
                        Margin="0,0,10,0" 
                        Background="#2ECC71" 
                        Foreground="White" 
                        BorderThickness="0"/>

                <Button Content="➖ 删除" 
                        Width="80" 
                        Height="30" 
                        Margin="0,0,10,0" 
                        Background="#E74C3C" 
                        Foreground="White" 
                        BorderThickness="0"/>

                <Button Content="🔄 刷新" 
                        Width="80" 
                        Height="30" 
                        Margin="0,0,10,0" 
                        Background="#3498DB" 
                        Foreground="White" 
                        BorderThickness="0"/>

                <!-- 利用 StackPanel 的特性：在右侧放一个搜索框，用 Margin:Auto 推开 -->
                <Border Width="120" 
                        Height="28" 
                        Background="White" 
                        CornerRadius="4" 
                        Margin="50,0,0,0">
                    <TextBlock Text="🔍 搜索联系人..." 
                               Foreground="#95A5A6" 
                               VerticalAlignment="Center" 
                               Margin="8,0"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============================================= -->
        <!-- 区域二：联系人列表（纵向 StackPanel + 滚动）   -->
        <!-- ============================================= -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      Background="#ECF0F1">

            <!-- 核心：纵向 StackPanel，用来堆叠每一个联系人 -->
            <StackPanel Orientation="Vertical" Margin="15">

                <!-- 注意：StackPanel 的子元素默认垂直方向会拉伸填满宽度（因为 HorizontalAlignment 默认 Stretch） -->

                <!-- 联系人 1 -->
                <Border Background="White" 
                        CornerRadius="6" 
                        Padding="12" 
                        Margin="0,0,0,8" 
                        BorderBrush="#BDC3C7" 
                        BorderThickness="1">
                    <!-- 内部嵌套横向 StackPanel 来布局 头像 + 姓名 + 状态 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 头像占位（圆形） -->
                        <Border Width="45" 
                                Height="45" 
                                Background="#3498DB" 
                                CornerRadius="22.5" 
                                VerticalAlignment="Center">
                            <TextBlock Text="张" 
                                       Foreground="White" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- 姓名和职位信息（纵向堆叠） -->
                        <StackPanel Orientation="Vertical" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="张三丰" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Text="技术总监 · 北京" FontSize="12" Foreground="#7F8C8D"/>
                        </StackPanel>

                        <!-- 状态标签（放在右侧，靠 Margin:Auto 推到最右边） -->
                        <Border Background="#2ECC71" 
                                CornerRadius="10" 
                                Padding="8,2" 
                                Margin="0,0,0,0" 
                                HorizontalAlignment="Right">
                            <TextBlock Text="在线" Foreground="White" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 联系人 2 -->
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#BDC3C7" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="45" Height="45" Background="#E67E22" CornerRadius="22.5" VerticalAlignment="Center">
                            <TextBlock Text="李" Foreground="White" FontSize="18" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Vertical" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="李思思" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Text="产品经理 · 上海" FontSize="12" Foreground="#7F8C8D"/>
                        </StackPanel>
                        <Border Background="#F1C40F" CornerRadius="10" Padding="8,2" Margin="0,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="忙碌" Foreground="White" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 联系人 3 -->
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#BDC3C7" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="45" Height="45" Background="#9B59B6" CornerRadius="22.5" VerticalAlignment="Center">
                            <TextBlock Text="王" Foreground="White" FontSize="18" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Vertical" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="王小明" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Text="UI 设计师 · 深圳" FontSize="12" Foreground="#7F8C8D"/>
                        </StackPanel>
                        <Border Background="#95A5A6" CornerRadius="10" Padding="8,2" Margin="0,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="离线" Foreground="White" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 联系人 4 -->
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#BDC3C7" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="45" Height="45" Background="#1ABC9C" CornerRadius="22.5" VerticalAlignment="Center">
                            <TextBlock Text="赵" Foreground="White" FontSize="18" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Vertical" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="赵灵儿" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Text="测试工程师 · 成都" FontSize="12" Foreground="#7F8C8D"/>
                        </StackPanel>
                        <Border Background="#2ECC71" CornerRadius="10" Padding="8,2" Margin="0,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="在线" Foreground="White" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 联系人 5（再加一条，让列表能稍微撑出滚动效果） -->
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#BDC3C7" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="45" Height="45" Background="#E74C3C" CornerRadius="22.5" VerticalAlignment="Center">
                            <TextBlock Text="陈" Foreground="White" FontSize="18" FontWeight="Bold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Vertical" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="陈小星" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Text="运维工程师 · 广州" FontSize="12" Foreground="#7F8C8D"/>
                        </StackPanel>
                            <Border Background="#F1C40F" CornerRadius="10" Padding="8,2" Margin="0,0,0,0" HorizontalAlignment="Right">
                                <TextBlock Text="忙碌" Foreground="White" FontSize="11"/>
                            </Border>
                     </StackPanel>
                </Border>

                <!-- 底部提示：在纵向 StackPanel 最后加一个友情提示 -->
                <TextBlock Text="—— 共 5 位联系人 ——" 
                           Foreground="#BDC3C7" 
                           HorizontalAlignment="Center" 
                           Margin="0,15,0,10" 
                           FontSize="12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

<!--
    StackPanel是构建 工具栏、菜单栏、列表项、表单行 的最高频控件。
    
    “联系人通讯录” 案例
    
    设计思路（核心策略）
    这个案例会同时展示 横向 StackPanel 和 纵向 StackPanel 的嵌套使用。

    1，整体结构：使用一个外层 Grid 把窗口分为上下两行（顶部工具栏 + 底部列表区），这样顶部固定，底部可滚动。
    2，顶部工具栏（横向 StackPanel）：将“新增”、“删除”、“刷新”按钮横向一字排开，并用 Margin 控制按钮间距，实现标准的工具栏效果。
    3，联系人列表（纵向 StackPanel）：每个联系人都用一个横向的 StackPanel 来展示（头像占位 + 姓名 + 状态标签），多个联系人再用纵向的 StackPanel 堆叠起来。
    4，核心难点攻克（ScrollViewer）：StackPanel 默认会给子元素无限空间，导致内容超出窗口时不会出现滚动条。因此，必须把纵向 StackPanel 放在 ScrollViewer 里，并限制高度，才能实现滚动效果。
-->