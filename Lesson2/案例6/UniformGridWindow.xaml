<Window x:Class="Lesson2.案例6.UniformGridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson2.案例6"
        mc:Ignorable="d"
        Title="UniformGridWindow"
        Height="500" 
        Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                   Text="UniformGrid 应用示例" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,10" Foreground="#2C3E50"/>

        <!-- ============================================= -->
        <!-- 实例一：计算器按键面板（4x4 UniformGrid）    -->
        <!-- ============================================= -->
        <Border Grid.Row="1" Grid.Column="0" 
                Background="#ECF0F1" 
                BorderBrush="#BDC3C7" 
                BorderThickness="2" 
                CornerRadius="8" 
                Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 计算器显示屏 -->
                <Border Grid.Row="0" Background="#2C3E50" Height="60" CornerRadius="4" Margin="5">
                    <TextBlock Text="0" Foreground="White" FontSize="28" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" 
                               Margin="10,0" FontWeight="Bold"/>
                </Border>
                <!-- UniformGrid 按键 -->
                <UniformGrid Grid.Row="1" Rows="4" Columns="4" Margin="5">
                    <Button Content="7" Background="#3498DB" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="8" Background="#3498DB" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="9" Background="#3498DB" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="÷" Background="#E67E22" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="4" Background="#3498DB" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="5" Background="#3498DB" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="6" Background="#3498DB" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="×" Background="#E67E22" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="1" Background="#3498DB" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="2" Background="#3498DB" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="3" Background="#3498DB" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="-" Background="#E67E22" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="0" Background="#3498DB" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="." Background="#3498DB" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="=" Background="#2ECC71" Foreground="White" FontSize="18" BorderThickness="0"/>
                    <Button Content="+" Background="#E67E22" Foreground="White" FontSize="18" BorderThickness="0"/>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- 分隔线 -->
        <Rectangle Grid.Row="1" Grid.Column="1" Fill="#BDC3C7" Width="2" Margin="0,20"/>

        <!-- ============================================= -->
        <!-- 实例二：照片墙（3行x4列 UniformGrid）        -->
        <!-- ============================================= -->
        <Border Grid.Row="1" Grid.Column="2" 
                Background="#F4F6F7" 
                BorderBrush="#BDC3C7" 
                BorderThickness="2" 
                CornerRadius="8" 
                Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📷 照片墙 (3×4)" 
                           FontSize="16" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,8" Foreground="#2C3E50"/>
                <!-- UniformGrid 展示 12 张缩略图 -->
                <UniformGrid Grid.Row="1" Rows="3" Columns="4" Margin="10">
                    <!-- 用 Border 模拟图片，每个 Border 填充不同颜色，并带有图标文字 -->
                    <Border Background="#E74C3C" CornerRadius="4">
                        <TextBlock Text="🌅" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <Border Background="#3498DB" CornerRadius="4">
                        <TextBlock Text="🏙️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <Border Background="#2ECC71" CornerRadius="4">
                        <TextBlock Text="🌲" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <Border Background="#9B59B6" CornerRadius="4">
                        <TextBlock Text="🎨" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <Border Background="#1ABC9C" CornerRadius="4">
                        <TextBlock Text="🚀" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <Border Background="#E67E22" CornerRadius="4">
                        <TextBlock Text="🍔" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <Border Background="#F39C12" CornerRadius="4">
                        <TextBlock Text="🎵" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <Border Background="#16A085" CornerRadius="4">
                        <TextBlock Text="📚" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <Border Background="#2980B9" CornerRadius="4">
                        <TextBlock Text="🏀" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <Border Background="#8E44AD" CornerRadius="4">
                        <TextBlock Text="✈️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <Border Background="#D35400" CornerRadius="4">
                        <TextBlock Text="🏜️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <Border Background="#27AE60" CornerRadius="4">
                        <TextBlock Text="🐾" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>

    
<!--
    设计思路
    - 1，UniformGrid 的核心特性：
      - 它像 Grid，但所有行和列的大小完全相等（均匀分配）。
      - 不需要定义 RowDefinition 和 ColumnDefinition，只需设置 Rows 和 Columns 属性（或不设置，自动根据子元素数量计算）。
      - 子元素按行优先顺序依次填充，每个格子大小完全一致，非常适合做棋盘、计算器按键、图标面板、九宫格等。
    
    - 2，本案例要展示的场景：
      - 我们设计两个实例：
        实例一：计算器按键面板 —— 一个 4 行 × 4 列的 UniformGrid，放置数字和运算符按钮，所有按键等大，美观整齐。
        实例二：照片墙（缩略图网格） —— 3 行 × 4 列，展示 12 张图片缩略图（用彩色方块替代），均分空间，适合展示图库预览。
    
    -3，为什么用 UniformGrid：
     - 如果使用 Grid，你需要手动设置每个 RowDefinition 和 ColumnDefinition 的 Height="*" 和 Width="*"，代码冗长。UniformGrid 一行属性搞定。
     - 它是计算器、九宫格等场景的“标准答案”。
-->