                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Margin="5">
                            <TextBlock Text="🌌" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock Text="星空" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                            <TextBlock Text="3840×2160" Foreground="White" FontSize="10" TextAlignment="Center" Opacity="0.8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 卡片 11 -->
                <Border Background="#D35400" Margin="0,0,10,10" CornerRadius="8" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Margin="5">
                            <TextBlock Text="🏜️" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock Text="沙漠" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                            <TextBlock Text="2000×1333" Foreground="White" FontSize="10" TextAlignment="Center" Opacity="0.8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 卡片 12 -->
                <Border Background="#27AE60" Margin="0,0,10,10" CornerRadius="8" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Margin="5">
                            <TextBlock Text="🐾" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock Text="动物" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                            <TextBlock Text="1024×768" Foreground="White" FontSize="10" TextAlignment="Center" Opacity="0.8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</Window>

   
<!--
    图片标签云” 案例
    
    设计思路（核心策略）
    - 1，WrapPanel 的核心特性：
      - 与 StackPanel 相同：它也是按顺序排列子元素（横向或纵向）。
      - 区别：当一行（或一列）空间不够时，会自动换到下一行（或下一列），就像 Word 里的文字折行一样。
      - 非常适合展示数量不定、大小不一的元素集合，例如：标签列表、图片缩略图、彩色卡片、菜单图标等。

    - 2，本案例要展示的场景：
      - 我们做一个“图片素材库”的缩略图浏览界面。
      - 顶部有一个横向的 WrapPanel 作为“筛选标签栏”，标签数量多了会自动换行。
      - 下方的主体区域使用 ScrollViewer + WrapPanel 组合，展示大量图片卡片，当窗口变窄时，卡片自动换行排列，并且支持滚动查看所有内容。

    - 3，关键难点处理：
      - WrapPanel 本身不支持滚动，内容过多时会超出窗口边界。因此，必须将 WrapPanel 放在 ScrollViewer 中（与 StackPanel 的处理方式一致）。
      - WrapPanel 中每个子元素的尺寸最好保持一致（或者通过 ItemWidth/ItemHeight 统一），否则换行会显得凌乱。
    
-->