                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 卡片 10 -->
                <Border Background="#8E44AD" Margin="0,0,10,10" CornerRadius="8" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
