<Window x:Class="Lesson2.案例3.WrapPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson2.案例3"
        mc:Ignorable="d"
        Title="WrapPanelWindow" Height="450" Width="800">
    <!-- 外层 Grid：分两行，顶部工具栏 + 下方可滚动内容 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 标签栏 -->
            <RowDefinition Height="*" />
            <!-- 图片网格 -->
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- 区域一：顶部标签筛选栏（WrapPanel 横向换行）       -->
        <!-- ================================================= -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="12,8">
            <!-- 使用 WrapPanel 水平排列标签，宽度不够时自动换行 -->
            <WrapPanel Orientation="Horizontal" 
                       ItemWidth="80"          
                       ItemHeight="30"
                       HorizontalAlignment="Left">
                <!-- 每个标签统一宽度，方便对齐 -->
                <!-- 统一高度 -->

                <!-- 标签按钮，自动换行展示 -->
                <Button Content="📷 全部" Background="#3498DB" Foreground="White" BorderThickness="0" Margin="0,0,8,8"/>
                <Button Content="🏔️ 自然" Background="#2ECC71" Foreground="White" BorderThickness="0" Margin="0,0,8,8"/>
                <Button Content="🌆 城市" Background="#E67E22" Foreground="White" BorderThickness="0" Margin="0,0,8,8"/>
                <Button Content="🎨 艺术" Background="#9B59B6" Foreground="White" BorderThickness="0" Margin="0,0,8,8"/>
                <Button Content="🚀 科技" Background="#1ABC9C" Foreground="White" BorderThickness="0" Margin="0,0,8,8"/>
                <Button Content="🍔 美食" Background="#E74C3C" Foreground="White" BorderThickness="0" Margin="0,0,8,8"/>
                <Button Content="🎵 音乐" Background="#F39C12" Foreground="White" BorderThickness="0" Margin="0,0,8,8"/>
                <Button Content="📚 教育" Background="#16A085" Foreground="White" BorderThickness="0" Margin="0,0,8,8"/>
                <!-- 再多加两个，演示换行效果 -->
                <Button Content="🏀 运动" Background="#2980B9" Foreground="White" BorderThickness="0" Margin="0,0,8,8"/>
                <Button Content="✈️ 旅行" Background="#8E44AD" Foreground="White" BorderThickness="0" Margin="0,0,8,8"/>
            </WrapPanel>
        </Border>

        <!-- ================================================= -->
        <!-- 区域二：图片缩略图网格（WrapPanel + ScrollViewer） -->
        <!-- ================================================= -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Background="#ECF0F1">

            <!-- 核心：纵向排列的 WrapPanel，每行自动换行 -->
            <WrapPanel Orientation="Horizontal" 
                       ItemWidth="150"          
                       ItemHeight="180"
                       Margin="15">
                <!-- 每个卡片固定宽度 -->
                <!-- 固定高度，保证整齐排列 -->

                <!-- 模拟 12 张图片卡片，用 Border 代替 Image（简化演示） -->
                <!-- 卡片 1 -->
                <Border Background="#3498DB" Margin="0,0,10,10" CornerRadius="8" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 图片占位 -->
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Margin="5">
                            <TextBlock Text="🌅" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- 标题 -->
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock Text="日出" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                            <TextBlock Text="1200×800" Foreground="White" FontSize="10" TextAlignment="Center" Opacity="0.8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 卡片 2 -->
                <Border Background="#E67E22" Margin="0,0,10,10" CornerRadius="8" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Margin="5">
                            <TextBlock Text="🏙️" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock Text="城市夜景" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                            <TextBlock Text="2000×1200" Foreground="White" FontSize="10" TextAlignment="Center" Opacity="0.8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 卡片 3 -->
                <Border Background="#2ECC71" Margin="0,0,10,10" CornerRadius="8" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Margin="5">
                            <TextBlock Text="🌲" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock Text="森林秘境" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                            <TextBlock Text="1600×900" Foreground="White" FontSize="10" TextAlignment="Center" Opacity="0.8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 卡片 4 -->
                <Border Background="#9B59B6" Margin="0,0,10,10" CornerRadius="8" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Margin="5">
                            <TextBlock Text="🎨" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock Text="抽象艺术" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                            <TextBlock Text="800×800" Foreground="White" FontSize="10" TextAlignment="Center" Opacity="0.8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 卡片 5 -->
                <Border Background="#1ABC9C" Margin="0,0,10,10" CornerRadius="8" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Margin="5">
                            <TextBlock Text="🚀" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock Text="火箭发射" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                            <TextBlock Text="1920×1080" Foreground="White" FontSize="10" TextAlignment="Center" Opacity="0.8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 卡片 6 -->
                <Border Background="#E74C3C" Margin="0,0,10,10" CornerRadius="8" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Margin="5">
                            <TextBlock Text="🍣" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock Text="美食诱惑" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                            <TextBlock Text="1200×800" Foreground="White" FontSize="10" TextAlignment="Center" Opacity="0.8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 卡片 7 -->
                <Border Background="#F39C12" Margin="0,0,10,10" CornerRadius="8" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Margin="5">
                            <TextBlock Text="🎸" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock Text="摇滚现场" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                            <TextBlock Text="1600×900" Foreground="White" FontSize="10" TextAlignment="Center" Opacity="0.8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 卡片 8 -->
                <Border Background="#16A085" Margin="0,0,10,10" CornerRadius="8" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Margin="5">
                            <TextBlock Text="📖" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock Text="读书时光" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
                            <TextBlock Text="1000×1000" Foreground="White" FontSize="10" TextAlignment="Center" Opacity="0.8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 再加 4 张，凑成 12 张，让换行效果更明显 -->
                <!-- 卡片 9 -->
                <Border Background="#2980B9" Margin="0,0,10,10" CornerRadius="8" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White" CornerRadius="4" Margin="5">
                            <TextBlock Text="🏄" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="5">
                            <TextBlock Text="冲浪" Foreground="White" FontWeight="Bold" FontSize="14" TextAlignment="Center"/>
