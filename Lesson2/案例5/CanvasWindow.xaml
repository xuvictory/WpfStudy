<Window x:Class="Lesson2.案例5.CanvasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson2.案例5"
        mc:Ignorable="d"
        Title="CanvasWindow" 
        Height="500" 
        Width="700"
        WindowStartupLocation="CenterScreen">
    <!-- 根容器：Grid 用于整体居中，并给 Canvas 留出空间 -->
    <Grid Background="#87CEEB">
        <!-- 浅蓝天空背景 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================ -->
        <!-- Canvas：所有图形元素的绝对定位画布           -->
        <!-- 设置宽高，ClipToBounds="True" 默认裁剪超出   -->
        <!-- ============================================ -->
        <Canvas Width="650" Height="450" 
                Margin="25" 
                Background="#B0E0E6"   
            ClipToBounds="True">
            <!-- 默认 True，裁剪超出部分 -->
            <!-- 内部浅背景，更明显 -->

            <!-- 1. 云朵（用多个椭圆组合）放在背景层，ZIndex 设为 0 -->
            <!-- 左云 -->
            <Canvas.ZIndex>
                <Binding Path="ZIndex" />
            </Canvas.ZIndex>
            <Ellipse Canvas.Left="30" Canvas.Top="50" 
                     Width="80" Height="40" Fill="White" Opacity="0.8"/>
            <Ellipse Canvas.Left="60" Canvas.Top="30" 
                     Width="60" Height="50" Fill="White" Opacity="0.8"/>
            <Ellipse Canvas.Left="100" Canvas.Top="40" 
                     Width="70" Height="35" Fill="White" Opacity="0.8"/>

            <!-- 右云 -->
            <Ellipse Canvas.Left="480" Canvas.Top="80" 
                     Width="90" Height="45" Fill="White" Opacity="0.7"/>
            <Ellipse Canvas.Left="520" Canvas.Top="60" 
                     Width="70" Height="55" Fill="White" Opacity="0.7"/>
            <Ellipse Canvas.Left="560" Canvas.Top="70" 
                     Width="80" Height="40" Fill="White" Opacity="0.7"/>

            <!-- 2. 热气球主体（由多个形状组成） -->
            <!-- 用 Canvas 嵌套实现局部坐标，便于整体移动 -->
            <Canvas Canvas.Left="250" Canvas.Top="50">
                <!-- 气球的球囊（用 Path 绘制，或者用多个椭圆叠加，这里使用 Ellipse + 渐变） -->
                <Ellipse Width="160" Height="180" 
                         Canvas.Left="-80" Canvas.Top="-10">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.3,0.3">
                            <GradientStop Color="#FF6B6B" Offset="0"/>
                            <GradientStop Color="#EE5A24" Offset="0.7"/>
                            <GradientStop Color="#D63031" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="#C0392B" />
                    </Ellipse.Stroke>
                    <Ellipse.StrokeThickness>2</Ellipse.StrokeThickness>
                </Ellipse>

                <!-- 气球上的装饰条纹（用 Rectangle 旋转） -->
                <Rectangle Width="120" Height="15" Fill="Gold" 
                           Canvas.Left="-60" Canvas.Top="30" />
                <Rectangle Width="120" Height="15" Fill="Gold" 
                           Canvas.Left="-60" Canvas.Top="60" />
                <Rectangle Width="120" Height="15" Fill="Gold" 
                           Canvas.Left="-60" Canvas.Top="90" />

                <!-- 吊篮（矩形） -->
                <Rectangle Width="50" Height="30" Fill="#8B4513" 
                           Canvas.Left="-25" Canvas.Top="170" 
                           Stroke="Black" StrokeThickness="1"/>

                <!-- 绳索（用两条 Line） -->
                <Line X1="-25" Y1="170" X2="-10" Y2="140" Stroke="SaddleBrown" StrokeThickness="2"/>
                <Line X1="25" Y1="170" X2="10" Y2="140" Stroke="SaddleBrown" StrokeThickness="2"/>
                <Line X1="-15" Y1="170" X2="-8" Y2="150" Stroke="SaddleBrown" StrokeThickness="2"/>
                <Line X1="15" Y1="170" X2="8" Y2="150" Stroke="SaddleBrown" StrokeThickness="2"/>

                <!-- 球囊顶部的小装饰（星形） -->
                <Ellipse Width="20" Height="20" Fill="Gold" 
                         Canvas.Left="-10" Canvas.Top="-20" />
                <TextBlock Canvas.Left="-8" Canvas.Top="-18" 
                           FontSize="14" Foreground="DarkRed" Text="★"/>
            </Canvas>

            <!-- 3. 地上的草地（用矩形和折线） -->
            <Rectangle Canvas.Left="0" Canvas.Top="380" 
                       Width="650" Height="70" Fill="#2ECC71" />
            <Path Canvas.Left="0" Canvas.Top="380" 
                  Stroke="Green" StrokeThickness="2" Fill="#27AE60"
                  Data="M 0,380 Q 50,360 100,380 Q 150,355 200,380 Q 250,365 300,380 Q 350,360 400,380 Q 450,355 500,380 Q 550,365 600,380 Q 650,360 650,380 L 650,450 L 0,450 Z" />

            <!-- 4. 太阳（位于右上角） -->
            <Ellipse Canvas.Left="550" Canvas.Top="20" 
                     Width="60" Height="60" Fill="#F1C40F" 
                     Canvas.ZIndex="1" />
            <Ellipse Canvas.Left="550" Canvas.Top="20" 
                     Width="60" Height="60" Fill="#F39C12" Opacity="0.3"
                     Canvas.ZIndex="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform ScaleX="1.8" ScaleY="1.8"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <!-- 太阳的光芒（用多个 Line） -->
            <Line X1="580" Y1="5" X2="580" Y2="-10" Stroke="#F1C40F" StrokeThickness="3" Canvas.ZIndex="2"/>
            <Line X1="600" Y1="20" X2="615" Y2="10" Stroke="#F1C40F" StrokeThickness="3" Canvas.ZIndex="2"/>
            <Line X1="610" Y1="50" X2="630" Y2="50" Stroke="#F1C40F" StrokeThickness="3" Canvas.ZIndex="2"/>
            <Line X1="600" Y1="80" X2="615" Y2="90" Stroke="#F1C40F" StrokeThickness="3" Canvas.ZIndex="2"/>

            <!-- 5. 文字标签（绝对定位） -->
            <TextBlock Canvas.Left="20" Canvas.Top="20" 
                       FontSize="18" FontWeight="Bold" Foreground="White"
                       Text="🎈 热气球之旅" />

            <!-- 坐标参考线（示范 Canvas.Left/Top 的用法） -->
            <Line X1="0" Y1="225" X2="650" Y2="225" Stroke="Red" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.3"/>
            <Line X1="325" Y1="0" X2="325" Y2="450" Stroke="Red" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.3"/>
            <TextBlock Canvas.Left="330" Canvas.Top="10" FontSize="10" Foreground="Gray" Text="X=325, Y=0 (参考线)"/>

            <!-- 底部版权说明 -->
            <TextBlock Canvas.Left="250" Canvas.Top="420" 
                       FontSize="12" Foreground="White" Opacity="0.6"
                       Text="Canvas 绝对定位示例" />

        </Canvas>
    </Grid>
</Window>

<!--
    WPF 中唯一采用 绝对定位 的布局容器。
    它不负责自动排列，而是让你通过坐标精确控制每个元素的位置，常用于 绘图、动画、游戏、图表、设计器 等需要像素级控制的场景。
    
    “彩色热气球”案例
    
    设计思路
    - 1，Canvas 的核心特性：
      - 子元素通过附加属性 Canvas.Left、Canvas.Top（或 Canvas.Right、Canvas.Bottom）指定相对于 Canvas 左上角（或右下角）的坐标。
      - 默认情况下，子元素不会自动拉伸或排列，完全由你决定位置和大小。
      - 通过 Canvas.ZIndex 附加属性控制元素的叠放顺序（数值越大越靠前）。
    
    - 2，本案例要展示的场景：
      - 我们将绘制一个 “彩色热气球” 场景：包含热气球（圆形+吊篮+绳索）、背景天空（带云朵）、文字标题和坐标参考线。
      - 通过 Canvas 精确放置每个图形元素，展示坐标定位、ZIndex 控制叠放、以及 Canvas 嵌套。
    
    - 3，为什么用 Canvas：
      - 虽然 Grid 等布局更常用，但 Canvas 在图形绘制、自定义控件、游戏开发中不可或缺。本案例让你感受“画布式”编程的灵活性。
-->