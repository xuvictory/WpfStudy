<Window x:Class="Lesson2.案例8.ScrollViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lesson2.案例8"
        mc:Ignorable="d"
        Title="ScrollViewerWindow" 
        Height="500" 
        Width="700"
        WindowStartupLocation="CenterScreen">
    <!-- 根 Grid：分为两列，左侧主体，右侧小图片预览 -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ============================================ -->
        <!-- 左侧主体：联系人列表（带滚动）               -->
        <!-- ============================================ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="📇 联系人列表 (动态添加)" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="#2C3E50" Margin="0,0,0,10"/>

            <!-- ScrollViewer 占据中间行（*），因此高度被限制 -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="#ECF0F1"
                          BorderBrush="#BDC3C7" 
                          BorderThickness="1" 
                          Margin="0,0,0,10">

                <!-- 内容容器：StackPanel 纵向排列联系人卡片 -->
                <StackPanel x:Name="ContactStackPanel" Margin="10">
                    <!-- 初始预置几条联系人 -->
                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#D5D8DC" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="张三丰" FontSize="16" FontWeight="SemiBold" Margin="0,0,20,0"/>
                            <TextBlock Text="技术总监" Foreground="#7F8C8D"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#D5D8DC" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👩" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="李思思" FontSize="16" FontWeight="SemiBold" Margin="0,0,20,0"/>
                            <TextBlock Text="产品经理" Foreground="#7F8C8D"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#D5D8DC" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👨" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock Text="王小明" FontSize="16" FontWeight="SemiBold" Margin="0,0,20,0"/>
                            <TextBlock Text="UI 设计师" Foreground="#7F8C8D"/>
                        </StackPanel>
                    </Border>
                    <!-- 更多项会由后台动态添加 -->
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮：动态添加联系人 -->
            <Button Grid.Row="2" 
                    Content="➕ 添加联系人" 
                    Click="AddContact_Click" 
                    Background="#3498DB" 
                    Foreground="White" 
                    BorderThickness="0"
                    Height="40"
                    FontSize="16"/>
        </Grid>

        <!-- 分隔线 -->
        <Rectangle Grid.Column="1" Fill="#BDC3C7" Width="2" Margin="10,0"/>

        <!-- ============================================ -->
        <!-- 右侧：图片浏览（水平和垂直双向滚动）         -->
        <!-- ============================================ -->
        <Border Grid.Column="2" 
                BorderBrush="#BDC3C7" 
                BorderThickness="1" 
                CornerRadius="8" 
                Margin="10,0,0,0"
                Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="🖼️ 大图浏览" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,8" 
                           Foreground="#2C3E50"/>
                <!-- ScrollViewer 支持水平和垂直滚动 -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Width="180" 
                              Height="350"
                              Background="#F4F6F7"
                              BorderBrush="#D5D8DC" 
                              BorderThickness="1">
                    <!-- 一张模拟的大图（用 Canvas 绘制彩色网格） -->
                    <Border Width="300" Height="400" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 彩色方块模拟图片内容 -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#E74C3C"/>
                            <Border Grid.Row="0" Grid.Column="1" Background="#3498DB"/>
                            <Border Grid.Row="0" Grid.Column="2" Background="#2ECC71"/>
                            <Border Grid.Row="1" Grid.Column="0" Background="#F1C40F"/>
                            <Border Grid.Row="1" Grid.Column="1" Background="#9B59B6"/>
                            <Border Grid.Row="1" Grid.Column="2" Background="#1ABC9C"/>
                            <Border Grid.Row="2" Grid.Column="0" Background="#E67E22"/>
                            <Border Grid.Row="2" Grid.Column="1" Background="#95A5A6"/>
                            <Border Grid.Row="2" Grid.Column="2" Background="#34495E"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       Text="实际尺寸 300x400" 
                                       Foreground="White" 
                                       FontSize="14" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ScrollViewer>
                <TextBlock Grid.Row="1" Text="滚动查看完整图像" 
                           FontSize="10" Foreground="#7F8C8D" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Bottom" 
                           Margin="0,0,0,5"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<!--
    它是 WPF 中处理内容溢出的核心控件。
    当内容超出显示区域时，它可以提供滚动条让用户滚动查看，常见于长表单、列表、图片浏览器、代码编辑器等。
    
    
    设计思路
    - 1，ScrollViewer 的核心特性：
      - 它可以包含任何单个子元素（如 Grid、StackPanel、Image 等）。
      - 通过 VerticalScrollBarVisibility 和 HorizontalScrollBarVisibility 控制滚动条显示策略（Auto、Disabled、Hidden、Visible）。
      - 默认只支持单向滚动（垂直或水平），但通过设置 CanContentScroll 和 PanningMode 可以改变滚动行为。
      - 关键误区：ScrollViewer 不会自动限制子元素的大小。
        如果子元素（如 StackPanel）向父容器请求无限空间，ScrollViewer 会认为“空间无限”，从而禁用滚动条。
        因此，必须限制 ScrollViewer 的尺寸（通过固定 Height/Width，或使用 Grid 的行/列 * 分配）。
    
    - 2，本案例要展示的场景：
      - 场景一（主体）：一个“长列表联系人”页面，顶部有标题，中间是 ScrollViewer 包裹的 StackPanel，底部有“动态添加”按钮，可以不断添加新项，观察滚动条自动出现。
      - 场景二（辅助）：在一个角落展示“大图片”滚动，模拟图像查看器，水平和垂直滚动条同时启用。
    
    - 3，为什么学 ScrollViewer：
      - 几乎所有需要展示大量数据或表单的应用都离不开它。
      - 理解它的“空间限制”原理是避免滚动无效的关键。
    
-->