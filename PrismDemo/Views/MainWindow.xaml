<Window x:Class="PrismDemo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:PrismDemo.Common.Converters"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="智汇 POS 收银终端"
        Height="920" Width="1460" MinHeight="800" MinWidth="1340"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:ConnectionStateToBrushConverter x:Key="StateToBrush" />
        <conv:ConnectionStateToTextConverter x:Key="StateToText" />
        <conv:CurrencyConverter x:Key="Currency" />
        <conv:StatusLevelToBrushConverter x:Key="LevelToBrush" />

        <!-- 标题栏上的透明按钮（协议状态区可点击跳转） -->
        <Style x:Key="ChromeTransparentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="22" Padding="4,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavBackgroundAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ 顶部标题栏 ============================ -->
        <Border Grid.Row="0" Background="{StaticResource NavBackgroundBrush}"
                BorderBrush="{StaticResource NavBackgroundAltBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 品牌 + 门店 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9"
                            Background="{StaticResource BrandGradientBrush}">
                        <TextBlock Text="P" Foreground="White" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding StoreName}" Foreground="White" FontSize="15"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Border Background="{StaticResource NavBackgroundAltBrush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="收银终端 · Prism"
                                   Foreground="{StaticResource TextOnDarkMutedBrush}" FontSize="11" />
                    </Border>
                </StackPanel>

                <!-- 协议状态灯（点击进入设备监控） -->
                <Button Grid.Column="1"
                        Style="{StaticResource ChromeTransparentButton}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="device"
                        ToolTip="点击查看设备监控"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding ProtocolStatuses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource NavBackgroundAltBrush}" CornerRadius="20" Padding="10,5" Margin="4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                                        <TextBlock Text="{Binding ShortName}" Margin="7,0,0,0" FontSize="11"
                                                   Foreground="{StaticResource TextOnDarkBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border.ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding State, Converter={StaticResource StateToText}}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border.ToolTip>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Button>

                <!-- 收银员 + 时钟 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="8,0,10,0">
                    <TextBlock Text="{Binding CashierName}" Foreground="{StaticResource TextOnDarkMutedBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding CurrentTime}" Foreground="White" FontSize="15"
                               FontWeight="SemiBold" FontFamily="{StaticResource NumberFontFamily}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 窗口按钮 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;"
                            Click="OnMinimizeClick" ToolTip="最小化" />
                    <Button Style="{StaticResource WindowButton}" Content="&#xE922;"
                            Click="OnMaximizeClick" ToolTip="最大化 / 还原" />
                    <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;"
                            Click="OnCloseClick" ToolTip="关闭" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ 主体 ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="206" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{StaticResource NavBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="功能导航" Margin="24,18,0,10"
                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />

                    <ListBox Grid.Row="1"
                             Style="{StaticResource NavListBox}"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Margin="14,0,0,0" FontSize="14"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 当前交易汇总（由跨页面购物车消息驱动） -->
                    <Border Grid.Row="2" Margin="14,10,14,16" CornerRadius="12" Padding="14,12"
                            Background="{StaticResource NavBackgroundAltBrush}">
                        <StackPanel>
                            <TextBlock Text="当前交易" FontSize="11" Foreground="{StaticResource TextOnDarkMutedBrush}" />
                            <TextBlock Text="{Binding CartTotal, Converter={StaticResource Currency}}"
                                       FontFamily="{StaticResource NumberFontFamily}" FontSize="22"
                                       FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextOnDarkMutedBrush}" Margin="0,2,0,0">
                                <Run Text="共 " />
                                <Run Text="{Binding CartItemCount, Mode=OneWay}" />
                                <Run Text=" 件商品" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 内容区：Prism 区域，三个页面视图在此区域内按 key 导航切换 -->
            <Border Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
                <ContentControl prism:RegionManager.RegionName="ContentRegion" />
            </Border>
        </Grid>

        <!-- ============================ 底部提示条 ============================ -->
        <Border Grid.Row="2" Background="{StaticResource NavBackgroundAltBrush}" Padding="18,8"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{Binding StatusLevel, Converter={StaticResource LevelToBrush}}" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="10,0,0,0" FontSize="12"
                               Foreground="{StaticResource TextOnDarkSoftBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding CurrentDate}" HorizontalAlignment="Right" FontSize="12"
                           Foreground="{StaticResource TextOnDarkDimBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
