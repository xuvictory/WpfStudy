<UserControl x:Class="PrismDemo.Views.CashierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:conv="clr-namespace:PrismDemo.Common.Converters"
             xmlns:bh="clr-namespace:PrismDemo.Common.Behaviors"
             xmlns:controls="clr-namespace:PrismDemo.Common.Controls"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="Transparent">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="Currency" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:PaymentMethodToBooleanConverter x:Key="PaymentToBool" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />

        <!-- ==================== 分类标签 ==================== -->
        <Style x:Key="CategoryChipStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="10" Padding="14,9"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="Badge" CornerRadius="5" Padding="5,1"
                                            Background="{StaticResource DividerBrush}" VerticalAlignment="Center">
                                        <TextBlock x:Name="BadgeText" Text="{Binding Short}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" Margin="7,0,0,0"
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="Indicator" Width="20" Height="2.5" CornerRadius="2"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Background="{StaticResource PrimaryBrush}" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryLightBrush}" />
                                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryGhostBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Badge" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="BadgeText" Property="Foreground" Value="White" />
                                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== 商品卡片（用 Button 承载点击加购） ==================== -->
        <Style x:Key="ProductCardButton" TargetType="Button">
            <Setter Property="Width" Value="162" />
            <Setter Property="Height" Value="128" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="13,11"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <!-- 商品卡片在虚拟化列表中会被大量实例化/回收，Setter.Value 里的 Transform
                                     是所有实例共享的，必须 po:Freeze 冻结成只读，否则共享 Freezable 的
                                     渲染失效链会不断累积，点击时在文本排版（TextShaping.dll）处栈溢出崩溃。 -->
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-3" po:Freeze="True" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" po:Freeze="True" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== 商品卡片容器（虚拟化 ListBox 行，去掉默认选中样式） ==================== -->
        <Style x:Key="ProductCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}" Margin="18,16,18,16">
        <!-- PageRoot 的载入动画作用的 TranslateTransform 必须由本页面独有：
             三个页面共享同一个 Freezable 并各自施加动画时钟，会让渲染失效链累积，
             最终在文本排版处栈溢出崩溃。 -->
        <Grid.RenderTransform>
            <TranslateTransform Y="10" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="332" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             商品区
             ============================================================ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="商品选择" Style="{StaticResource TitleText}" />
                <TextBlock Text="点击卡片即可加入购物车" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Bottom" Margin="12,0,0,5" />
            </StackPanel>

            <!-- 工具条：搜索 + 手动条码 + 扫码枪 -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         bh:AttachedProps.Placeholder="搜索商品名称 / 编码 / 条码" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBox Width="200"
                             Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                             bh:AttachedProps.Placeholder="手动录入条码后回车"
                             bh:AttachedProps.EnterKeyCommand="{Binding AddByBarcodeCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                            Command="{Binding ScanCommand}" ToolTip="通过串口向扫码枪下发扫码指令">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="扫码" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 分类标签 -->
            <ListBox Grid.Row="2" Margin="0,14,0,0"
                     Style="{StaticResource PlainListBox}"
                     ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     ItemContainerStyle="{StaticResource CategoryChipStyle}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!-- 商品网格 -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <ListBox Margin="0,0,6,0"
                         Style="{StaticResource PlainListBox}"
                         ItemsSource="{Binding Products}"
                         ItemContainerStyle="{StaticResource ProductCardItemStyle}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- 虚拟化换行面板：仅实例化可视区卡片，布局与原 WrapPanel 一致 -->
                            <controls:VirtualizingWrapPanel ItemWidth="172" ItemHeight="138" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ProductCardButton}"
                                    Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="1" Text="{Binding Spec}" Style="{StaticResource CaptionText}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding Price, Converter={StaticResource Currency}}"
                                                   FontFamily="{StaticResource NumberFontFamily}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Text="{Binding Unit}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Bottom" Margin="3,0,0,4" />
                                    </StackPanel>

                                    <Grid Grid.Row="3" Margin="0,6,0,0">
                                        <TextBlock x:Name="StockText" Text="{Binding Stock, StringFormat=库存 {0}}"
                                                   Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        <Border x:Name="LowBadge" HorizontalAlignment="Right" CornerRadius="6"
                                                Padding="6,1" Background="{StaticResource DangerSoftBrush}"
                                                Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="库存紧张" FontSize="10" Foreground="{StaticResource DangerBrush}" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空态 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasProducts, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource IconFontFamily}" FontSize="38"
                               Foreground="{StaticResource DividerStrongBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="没有匹配的商品" Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>

            <!-- 统计文案由 ViewModel 统一生成：结果被上限截断时提示用关键字缩小范围 -->
            <TextBlock Grid.Row="4" Margin="0,10,0,0" Style="{StaticResource CaptionText}"
                       Text="{Binding ProductSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- ============================================================
             购物车
             ============================================================ -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 头部 -->
                <Border Grid.Row="0" Padding="16,14" BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="购物车" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource BadgeBase}" Margin="8,0,0,0"
                                    Background="{StaticResource PrimarySoftBrush}">
                                <TextBlock FontSize="11" Foreground="{StaticResource PrimaryDarkBrush}">
                                    <Run Text="{Binding ItemCount, Mode=OneWay}" />
                                    <Run Text=" 件" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Height="30"
                                Padding="12,0" Content="清空" Command="{Binding ClearCartCommand}" />
                    </Grid>
                </Border>

                <!-- 提示 -->
                <Border Grid.Row="1" Padding="16,10" Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="支持扫码枪直连加购；数量可增减，移除后金额实时重算。" TextWrapping="Wrap" />
                </Border>

                <!-- 列表 -->
                <Grid Grid.Row="2">
                    <ListBox Style="{StaticResource CardListBox}" Margin="10"
                             ItemsSource="{Binding CartItems}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0">
                                            <Run Text="{Binding Price, Converter={StaticResource Currency}, Mode=OneWay}" />
                                            <Run Text="/" />
                                            <Run Text="{Binding Unit, Mode=OneWay}" />
                                            <Run Text=" · 库存 " />
                                            <Run Text="{Binding Product.Stock}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="10,0">
                                        <Button Style="{StaticResource IconCircleButton}" Content="&#xE108;"
                                                ToolTip="减少数量"
                                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Quantity}" Width="38" TextAlignment="Center"
                                                   VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource NumberFontFamily}" />
                                        <!-- 数量已达可加购上限时禁用"+"：
                                             IsMaxQuantity 与购物车服务使用同一份上限规则（CartLimits），
                                             因此"允许超卖"打开后按钮会重新可用，不会出现"能点但加不进去"。 -->
                                        <Button Style="{StaticResource IconCircleButton}" Content="&#xE109;"
                                                ToolTip="增加数量"
                                                IsEnabled="{Binding IsMaxQuantity, Converter={StaticResource InverseBool}}"
                                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                MinWidth="96" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Subtotal, Converter={StaticResource Currency}}"
                                                   FontFamily="{StaticResource NumberFontFamily}" FontSize="15"
                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Button Style="{StaticResource IconCircleButton}" Content="&#xE74D;"
                                                Margin="8,0,0,0" ToolTip="移除该商品" Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空态 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                        <Border Width="66" Height="66" CornerRadius="33" HorizontalAlignment="Center"
                                Background="{StaticResource SurfaceAltBrush}">
                            <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource IconFontFamily}" FontSize="26"
                                       Foreground="{StaticResource DividerStrongBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="购物车还是空的" Style="{StaticResource BodyText}" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="从左侧选择商品加入" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================
             结算面板
             ============================================================ -->
        <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="结算收款" Style="{StaticResource SectionTitle}" />

                <!-- 合计 -->
                <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource PayGradientBrush}"
                        Padding="16,14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="应收合计" Foreground="{StaticResource PrimaryLightBrush}" FontSize="12" />
                        <TextBlock Text="{Binding Total, Converter={StaticResource Currency}}"
                                   FontFamily="{StaticResource NumberFontFamily}" FontSize="34" FontWeight="Bold"
                                   Foreground="White" Margin="0,4,0,0" />
                        <TextBlock Foreground="{StaticResource PrimaryLightBrush}" FontSize="11" Margin="0,6,0,0">
                            <Run Text="共 " />
                            <Run Text="{Binding ItemCount, Mode=OneWay}" />
                            <Run Text=" 件 · " />
                            <Run Text="{Binding KindCount, Mode=OneWay}" />
                            <Run Text=" 种商品" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 支付方式 -->
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="支付方式" Style="{StaticResource LabelText}" />
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <RadioButton Style="{StaticResource SegmentRadio}" Content="现金" Margin="0,0,6,0"
                                     IsChecked="{Binding PaymentMethod, Converter={StaticResource PaymentToBool}, ConverterParameter=Cash, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource SegmentRadio}" Content="扫码" Margin="3,0,3,0"
                                     IsChecked="{Binding PaymentMethod, Converter={StaticResource PaymentToBool}, ConverterParameter=QrCode, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource SegmentRadio}" Content="刷卡" Margin="6,0,0,0"
                                     IsChecked="{Binding PaymentMethod, Converter={StaticResource PaymentToBool}, ConverterParameter=BankCard, Mode=TwoWay}" />
                    </UniformGrid>
                </StackPanel>

                <!-- 实收金额（仅现金） -->
                <StackPanel Grid.Row="3" Margin="0,16,0,0"
                            Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="实收金额" Style="{StaticResource LabelText}" />
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Height="26"
                                Padding="10,0" FontSize="11" Content="收整"
                                Command="{Binding FillExactAmountCommand}" />
                    </Grid>
                    <TextBox Style="{StaticResource AmountTextBox}" Margin="0,8,0,0"
                             Text="{Binding PaidText, UpdateSourceTrigger=PropertyChanged}"
                             bh:AttachedProps.Placeholder="请输入顾客实付金额"
                             bh:AttachedProps.DecimalOnly="True"
                             bh:AttachedProps.EnterKeyCommand="{Binding CheckoutCommand}" />
                </StackPanel>

                <!-- 找零（可在设置页关闭提示） -->
                <Border Grid.Row="4" Style="{StaticResource SoftCardBorder}" Padding="14,10" Margin="0,14,0,0"
                        Visibility="{Binding ShowChangeHint, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="应找零" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Change, Converter={StaticResource Currency}}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource NumberFontFamily}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </Grid>
                </Border>

                <!-- 底部操作 -->
                <StackPanel Grid.Row="6">
                    <Button Style="{StaticResource AccentButton}" Command="{Binding CheckoutCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource IconFontFamily}" FontSize="17"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="结算收款" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextAlignment="Center"
                               Text="结算将联动客显屏、小票打印机、钱箱与云端上报" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
